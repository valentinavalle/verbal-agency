---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icono from './Icono.astro';

/**
 * Muestra una foto optimizada (webp, varios tamaños, lazy) o, si todavía no hay foto,
 * un placeholder prolijo. Cuando agregues el archivo a la carpeta correspondiente, se reemplaza solo.
 */
interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** Leyenda del placeholder. */
  leyenda?: string;
  ratio?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
}
const {
  src,
  alt = '',
  leyenda = 'Foto del proyecto',
  ratio = '4 / 3',
  sizes = '(min-width: 1000px) 380px, (min-width: 600px) 50vw, 100vw',
  widths = [400, 640, 960],
  eager = false,
  class: clase = '',
} = Astro.props;
---

<div class:list={['foto', clase]} style={`--ratio: ${ratio}`}>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="foto__img"
      />
    ) : (
      <div class="foto__placeholder" role="img" aria-label={leyenda}>
        <Icono nombre="camara" />
        <span>{leyenda}</span>
      </div>
    )
  }
</div>

<style>
  .foto {
    aspect-ratio: var(--ratio);
    border-radius: var(--radio-m);
    overflow: hidden;
    background: var(--lavanda);
  }
  .foto__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .foto__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--lavanda);
    border: 2px dashed var(--violeta);
    border-radius: var(--radio-m);
    color: var(--violeta);
    font-weight: 500;
    font-size: 0.9375rem;
    text-align: center;
    padding: 1rem;
  }
  .foto__placeholder :global(svg) {
    width: 2rem;
    height: 2rem;
  }
</style>
