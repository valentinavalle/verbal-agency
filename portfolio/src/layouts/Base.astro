---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { perfil } from '../data/perfil';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Ruta o URL absoluta de la imagen para compartir (Open Graph). */
  imagen?: string;
  tipo?: 'website' | 'article';
}
const {
  titulo = perfil.seo.titulo,
  descripcion = perfil.seo.descripcion,
  imagen = '/og.png',
  tipo = 'website',
} = Astro.props;

const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbsoluta = new URL(imagen, Astro.site).toString();

const datosPersona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: perfil.nombre,
  url: Astro.site?.toString(),
  email: perfil.contacto.mail,
  sameAs: [perfil.contacto.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#6B3DF5" />
    <link rel="canonical" href={canonica} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={perfil.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbsoluta} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Unbounded:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(datosPersona)} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Aparición suave de los elementos .reveal al entrar en pantalla.
      const elementos = document.querySelectorAll<HTMLElement>('.reveal');
      const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (sinMovimiento || !('IntersectionObserver' in window)) {
        elementos.forEach((el) => el.classList.add('visible'));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                const el = entrada.target as HTMLElement;
                el.classList.add('visible');
                observador.unobserve(el);
                // Terminada la aparición, se libera el elemento para que sus hovers funcionen normal.
                setTimeout(() => el.classList.remove('reveal', 'visible'), 1300);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        elementos.forEach((el) => observador.observe(el));
      }
    </script>
  </body>
</html>
