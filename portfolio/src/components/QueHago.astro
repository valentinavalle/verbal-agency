---
import { perfil } from '../data/perfil';
import Icono from './Icono.astro';

const { servicios } = perfil;
---

<section id="que-hago" class="seccion tema-lavanda" aria-labelledby="que-hago-titulo">
  <div class="contenedor">
    <h2 id="que-hago-titulo" class="titulo-seccion reveal">{servicios.titulo}</h2>
    <ul class="servicios">
      {
        servicios.items.map((s, i) => (
          <li class="servicio reveal" style={`--retraso: ${(i % 3) * 0.08}s`}>
            <span class="servicio__icono">
              <Icono nombre={s.icono} />
            </span>
            <h3 class="servicio__titulo">{s.titulo}</h3>
            <p>{s.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .servicios {
    display: grid;
    gap: 1.25rem;
  }
  .servicio {
    background: var(--blanco);
    border-radius: var(--radio-m);
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 2px solid transparent;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }
  .servicio:hover {
    transform: translateY(-6px);
    border-color: var(--violeta);
  }
  .servicio__icono {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--lima);
    color: var(--tinta);
    margin-bottom: 1.25rem;
    transition: background-color 0.25s ease;
  }
  .servicio:hover .servicio__icono {
    background: var(--rosa);
  }
  .servicio__icono :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }
  .servicio__titulo {
    font-family: var(--fuente-titulo);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.3;
    margin-bottom: 0.6rem;
  }
  .servicio p {
    color: var(--tinta-suave);
  }

  @media (min-width: 640px) {
    .servicios {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .servicios {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
</style>
