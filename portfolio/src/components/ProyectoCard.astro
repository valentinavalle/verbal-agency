---
import type { Proyecto } from '../data/proyectos';
import { fotosDeProyecto } from '../lib/imagenes';
import Foto from './Foto.astro';

interface Props {
  proyecto: Proyecto;
  numero: string;
}
const { proyecto, numero } = Astro.props;
const portada = fotosDeProyecto(proyecto.slug)[0];
---

<article class="card">
  <div class="card__foto">
    {/* alt vacío a propósito: el enlace ya se nombra con marca y título */}
    <Foto src={portada?.src} alt="" leyenda="Foto del proyecto" ratio="4 / 3" />
    <span class="numero card__numero" aria-hidden="true">{numero}</span>
    {proyecto.sello && <span class="card__sello">{proyecto.sello}</span>}
  </div>
  <div class="card__cuerpo">
    <p class="card__marca">{proyecto.marca}</p>
    <h3 class="card__titulo">
      <a href={`/proyectos/${proyecto.slug}`}>
        <span class="solo-lectores">Proyecto {numero}: </span>{proyecto.titulo}
      </a>
    </h3>
    <span class="card__mas" aria-hidden="true">Ver caso →</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--lavanda);
    border-radius: var(--radio-m);
    padding: 0.75rem 0.75rem 0;
    transition:
      transform 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease;
  }
  .card:hover {
    transform: translateY(-6px);
    background: var(--violeta);
    color: var(--blanco);
  }
  .card:has(a:focus-visible) {
    outline: 3px solid var(--violeta);
    outline-offset: 4px;
  }
  .card__foto {
    position: relative;
  }
  .card__foto :global(.foto) {
    border-radius: calc(var(--radio-m) - 8px);
  }
  .card__numero {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
  }
  .card__sello {
    position: absolute;
    right: 0.75rem;
    top: 0.85rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--pildora);
    background: var(--rosa);
    color: var(--tinta);
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 0.72rem;
    transform: rotate(4deg);
  }
  .card__cuerpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
    padding: 1.25rem 0.75rem 1.4rem;
  }
  .card__marca {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--tinta-suave);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.25s ease;
  }
  .card:hover .card__marca {
    color: var(--lima);
  }
  .card__titulo {
    font-family: var(--fuente-titulo);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.35;
  }
  .card__titulo a {
    color: inherit;
    text-decoration: none;
  }
  .card__titulo a:focus-visible {
    outline: none;
  }
  /* Toda la tarjeta es clickeable */
  .card__titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radio-m);
  }
  .card__mas {
    margin-top: auto;
    padding-top: 0.75rem;
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--violeta);
    transition: color 0.25s ease;
  }
  .card:hover .card__mas {
    color: var(--lima);
  }
</style>
